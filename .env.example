# API Tokens for SafeRoute
# ------------------------

# Search
# Photon search is used by default and does not require an API key.

# 1. Google Maps API Key
# Enable: Maps JavaScript API, Places API, Directions API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 2. Mapbox Access Token (optional fallback if Google is not configured)
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# 3. OpenWeatherMap API Key (Get one free at openweathermap.org/api)
VITE_OWM_KEY=your_openweathermap_api_key_here
